    <string name="feature_tracker_menu_end">End game</string>
    <string name="feature_tracker_menu_reset_timer">Reset timer</string>

    <!-- Round timer on the center strip. %1$d = minutes, %2$d = seconds. -->
    <string name="feature_tracker_timer_time">%1$02d:%2$02d</string>
    <!-- Overtime, counting up after 0, e.g. "+02:13". -->
    <string name="feature_tracker_timer_overtime">+%1$02d:%2$02d</string>
    <plurals name="feature_tracker_timer_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="feature_tracker_timer_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>
    <!-- %1$s = minutes part, %2$s = seconds part, e.g. "12 minutes 30 seconds". -->
    <string name="feature_tracker_timer_minutes_seconds">%1$s %2$s</string>
    <!-- %1$s = a duration, e.g. "12 minutes 30 seconds". -->
    <string name="feature_tracker_timer_left_description">%1$s left in round</string>
    <string name="feature_tracker_timer_over_description">%1$s over time</string>
