<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LegendAvatar accessibility labels. %1$s = player name, %2$s = Legend name. -->
    <string name="core_ui_legend_avatar_description">%1$s, Legend: %2$s</string>
    <string name="core_ui_legend_avatar_description_no_legend">%1$s, no Legend</string>
    <!-- %1$s = the avatar description above, %2$d = the player's points. -->
    <plurals name="core_ui_legend_avatar_description_with_score">
        <item quantity="one">%1$s, %2$d point</item>
        <item quantity="other">%1$s, %2$d points</item>
    </plurals>

    <!-- CounterRow. %1$s = player name, %2$s = counter label (e.g. XP), %3$d = value. -->
    <string name="core_ui_counter_description">%1$s, %2$s %3$d</string>
    <string name="core_ui_counter_increase">%1$s, %2$s, increase</string>
    <string name="core_ui_counter_decrease">%1$s, %2$s, decrease</string>
    <string name="core_ui_counter_remove">Remove</string>
    <string name="core_ui_counter_remove_description">Remove %2$s from %1$s</string>

    <!-- PlayerColorPicker. %1$d = position, %2$d = number of colors. -->
    <string name="core_ui_color_description">Color %1$d of %2$d</string>

    <!-- LegendPickerSheet. %1$s = player name. -->
    <string name="core_ui_choose_legend">Choose Legend for %1$s</string>
    <string name="core_ui_legend_none">None</string>
    <string name="core_ui_legend_search">Search Legends</string>
    <string name="core_ui_legend_empty">No Legends match</string>

    <!-- Game log lines (tracker history sheet, game detail). -->
    <!-- %1$s = name, %2$+d = signed change, %3$d = new total. Example: "Ana +1 · 6". -->
    <string name="core_ui_log_points">%1$s %2$+d · %3$d</string>
    <!-- %1$s = name, %2$s = counter label, %3$+d = signed change, %4$d = new value. Example: "Ana XP +2 · 4". -->
    <string name="core_ui_log_counter">%1$s %2$s %3$+d · %4$d</string>
    <string name="core_ui_log_counter_added">%1$s added %2$s</string>
    <string name="core_ui_log_counter_removed">%1$s removed %2$s</string>
    <string name="core_ui_log_target">Target score → %1$d</string>
    <string name="core_ui_log_ended_winner">Game ended · %1$s won</string>
    <string name="core_ui_log_ended">Game ended</string>
</resources>
