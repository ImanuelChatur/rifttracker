<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; all UI theming lives in Compose (RiftTheme). Dark-first background avoids a white flash. -->
    <style name="Theme.RiftTally" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Launch theme: the splash screen shows the app icon on the dark background, then hands over. -->
    <style name="Theme.RiftTally.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RiftTally</item>
    </style>

    <color name="window_background">#FF0E0F13</color>
</resources>
