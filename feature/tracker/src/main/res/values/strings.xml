<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="feature_tracker_title">Tracker</string>
    <string name="feature_tracker_back">Back</string>
    <string name="feature_tracker_not_found">This game can\'t be found.</string>

    <!-- Tap zones. %1$s = player (or team) name, %2$d = current points. Example: "Ana, 6 points, increase". -->
    <plurals name="feature_tracker_increase">
        <item quantity="one">%1$s, %2$d point, increase</item>
        <item quantity="other">%1$s, %2$d points, increase</item>
    </plurals>
    <plurals name="feature_tracker_decrease">
        <item quantity="one">%1$s, %2$d point, decrease</item>
        <item quantity="other">%1$s, %2$d points, decrease</item>
    </plurals>
    <string name="feature_tracker_at_target">Reached the target</string>
    <!-- Fading badge after a change. %1$+d = signed change, e.g. +1 or -2. -->
    <string name="feature_tracker_delta_badge">%1$+d</string>
    <!-- A side's score. %1$s = player or team members (e.g. "Ana &amp; Ben"), %2$d = points. -->
    <plurals name="feature_tracker_side_points">
        <item quantity="one">%1$s, %2$d point</item>
        <item quantity="other">%1$s, %2$d points</item>
    </plurals>

    <!-- Extra counters. %1$s = player name. -->
    <string name="feature_tracker_add_counter">+ Counter</string>
    <string name="feature_tracker_add_counter_for">Add counter for %1$s</string>
    <string name="feature_tracker_counter_dialog_title">Add counter for %1$s</string>
    <string name="feature_tracker_counter_preset_xp">XP</string>
    <string name="feature_tracker_counter_custom_label">Custom label</string>
    <string name="feature_tracker_counter_add">Add</string>

    <!-- Center strip. -->
    <string name="feature_tracker_undo">Undo</string>
    <string name="feature_tracker_menu">Game menu</string>
